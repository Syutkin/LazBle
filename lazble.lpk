<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="LazBle"/>
    <Type Value="RunTime"/>
    <Version Major="2" Minor="0" Release="0"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <IncludeFiles Value="simpledelphible\source"/>
        <OtherUnitFiles Value="src;src\backends;src\core;src\profiles;simpledelphible\source"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Conditionals Value="NativeDir := '';
if (TargetOS='linux') and (TargetCPU='x86_64') then
  NativeDir := 'simpledelphible/lib/linux-x64'
else if (TargetOS='win64') and (TargetCPU='x86_64') then
  NativeDir := 'simpledelphible/lib/win64'
else if (TargetOS='darwin') and (TargetCPU='x86_64') then
  NativeDir := 'simpledelphible/lib/macos-x64'
else if (TargetOS='darwin') and (TargetCPU='aarch64') then
  NativeDir := 'simpledelphible/lib/macos-arm64';
if NativeDir&lt;>'' then begin
  LibraryPath := NativeDir;
  UsageLibraryPath := NativeDir;
  UsageLinkerOptions := '-L&quot;$(PkgDir)' + NativeDir + '&quot;';
end;"/>
    </CompilerOptions>
    <Files>
      <Item>
        <Filename Value="src\core\lazbletypes.pas"/>
        <UnitName Value="LazBleTypes"/>
      </Item>
      <Item>
        <Filename Value="src\core\lazblebackend.pas"/>
        <UnitName Value="LazBleBackend"/>
      </Item>
      <Item>
        <Filename Value="src\core\lazbleoperation.pas"/>
        <UnitName Value="LazBleOperation"/>
      </Item>
      <Item>
        <Filename Value="src\core\lazblegattoperation.pas"/>
        <UnitName Value="LazBleGattOperation"/>
      </Item>
      <Item>
        <Filename Value="src\core\lazblegattsubscription.pas"/>
        <UnitName Value="LazBleGattSubscription"/>
      </Item>
      <Item>
        <Filename Value="src\core\lazblegattsession.pas"/>
        <UnitName Value="LazBleGattSession"/>
      </Item>
      <Item>
        <Filename Value="src\core\lazblegattprofile.pas"/>
        <UnitName Value="LazBleGattProfile"/>
      </Item>
      <Item>
        <Filename Value="src\core\lazblebytechannel.pas"/>
        <UnitName Value="LazBleByteChannel"/>
      </Item>
      <Item>
        <Filename Value="src\core\lazblecentralmanager.pas"/>
        <UnitName Value="LazBleCentralManager"/>
        <AddToUsesPkgSection Value="False"/>
      </Item>
      <Item>
        <Filename Value="src\core\lazbleclientinternal.pas"/>
        <UnitName Value="LazBleClientInternal"/>
        <AddToUsesPkgSection Value="False"/>
      </Item>
      <Item>
        <Filename Value="src\core\lazbleclient.pas"/>
        <UnitName Value="LazBleClient"/>
      </Item>
      <Item>
        <Filename Value="src\core\lazblereconnect.pas"/>
        <UnitName Value="LazBleReconnect"/>
        <AddToUsesPkgSection Value="False"/>
      </Item>
      <Item>
        <Filename Value="src\core\lazblefacade.pas"/>
        <UnitName Value="LazBleFacade"/>
      </Item>
      <Item>
        <Filename Value="src\core\lazblesync.pas"/>
        <UnitName Value="LazBleSync"/>
      </Item>
      <Item>
        <Filename Value="src\profiles\lazblenus.pas"/>
        <UnitName Value="LazBleNus"/>
      </Item>
      <Item>
        <Filename Value="src\profiles\lazblebattery.pas"/>
        <UnitName Value="LazBleBattery"/>
      </Item>
      <Item>
        <Filename Value="src\backends\lazblesimpleblebackend.pas"/>
        <UnitName Value="LazBleSimpleBleBackend"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
